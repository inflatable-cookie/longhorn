{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Longhorn Agent Control Proof",
  "version": "0.0.0",
  "identifier": "audio.example.longhorn-agent-control-proof",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Longhorn Agent Control Proof",
        "width": 520,
        "height": 320,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'none'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["../../../../examples/tauri-windowing-proof/src-tauri/icons/icon.png"]
  }
}
