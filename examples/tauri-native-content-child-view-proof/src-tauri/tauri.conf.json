{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Longhorn Native Content Child View Proof",
  "version": "0.0.0",
  "identifier": "audio.infiniteloop.longhorn-native-content-child-view-proof",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "controller",
      "title": "Longhorn native-content child-view proof controller",
      "width": 420,
      "height": 240,
      "visible": false,
      "resizable": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'none'; style-src 'none'; connect-src 'none'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["../../tauri-windowing-proof/src-tauri/icons/icon.png"]
  }
}
