{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@inflatable-cookie/longhorn/bridge": ["../../packages/longhorn/src/bridge/index.ts"],
      "@inflatable-cookie/longhorn/bridge/stream": ["../../packages/longhorn/src/bridge/stream.ts"],
      "@inflatable-cookie/longhorn/bridge/supervision": [
        "../../packages/longhorn/src/bridge/supervision.ts"
      ],
      "@inflatable-cookie/longhorn-tauri/bridge": ["../../packages/longhorn-tauri/src/bridge.ts"],
      "@inflatable-cookie/longhorn-tauri/bridge-events": [
        "../../packages/longhorn-tauri/src/bridge-events.ts"
      ]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["bun"]
  },
  "include": ["*.ts"]
}
