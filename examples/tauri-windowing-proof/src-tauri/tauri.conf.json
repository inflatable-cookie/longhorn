{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Longhorn Window Proof",
  "version": "0.1.0",
  "identifier": "audio.example.longhorn-window-proof",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Longhorn Window Proof",
        "width": 900,
        "height": 650,
        "visible": false,
        "resizable": true,
        "backgroundColor": "#101318"
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": []
  }
}
