{
  "schema": "longhorn.greenfield-capability.v1",
  "shape": "workspace",
  "applicationId": "com.example.longhorn.greenfield.workspace",
  "storageProfile": "platform-native-v1",
  "hierarchy": ["window", "layout-container", "region", "panel"],
  "systems": ["config", "windowing", "layout", "settings", "commands"],
  "permissions": [
    "allow-longhorn-settings-read",
    "allow-longhorn-settings-mutate",
    "allow-longhorn-command-read",
    "allow-longhorn-command-mutate",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging"
  ],
  "failurePosture": "visible-no-fallback",
  "service": "absent"
}
