{
  "schema": "longhorn.greenfield-capability.v1",
  "shape": "full-hosting",
  "applicationId": "com.example.longhorn.greenfield.full-hosting",
  "storageProfile": "platform-native-v1",
  "hierarchy": ["display", "window", "surface", "layout-container", "region", "panel"],
  "systems": ["config", "windowing", "layout", "surfaces", "transfer", "settings", "commands", "linear-history"],
  "permissions": [
    "allow-longhorn-settings-read",
    "allow-longhorn-settings-mutate",
    "allow-longhorn-command-read",
    "allow-longhorn-command-mutate",
    "allow-longhorn-transfer-base",
    "allow-longhorn-transfer-surface",
    "allow-longhorn-history-read",
    "allow-longhorn-history-mutate",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging"
  ],
  "failurePosture": "visible-no-fallback",
  "service": "absent",
  "history": "linear-only"
}
