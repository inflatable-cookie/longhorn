{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Longhorn Transfer Proof",
  "version": "0.1.0",
  "identifier": "audio.infiniteloop.longhorn-transfer-proof",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "source",
        "title": "Longhorn Transfer Proof — Source",
        "x": 40,
        "y": 80,
        "width": 560,
        "height": 500,
        "visible": true,
        "resizable": true,
        "backgroundColor": "#101318"
      },
      {
        "label": "target",
        "title": "Longhorn Transfer Proof — Target",
        "x": 660,
        "y": 80,
        "width": 560,
        "height": 500,
        "visible": true,
        "resizable": true,
        "backgroundColor": "#101318"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["../../tauri-windowing-proof/src-tauri/icons/icon.png"]
  }
}
