{
  "version": 1,
  "note": "The cross-backend projection contract. Rust checks it in longhorn-poodle; TypeScript checks it in longhorn-poodle-svelte. Either side drifting fails its own gate. Hand-written on purpose: the point is that two independent implementations agree, so neither generates the other. See card 171 and memo 022.",
  "notificationSeverityTone": [
    {
      "severity": "info",
      "tone": "info",
      "isLossy": false
    },
    {
      "severity": "success",
      "tone": "success",
      "isLossy": false
    },
    {
      "severity": "warning",
      "tone": "warning",
      "isLossy": false
    },
    {
      "severity": "error",
      "tone": "danger",
      "isLossy": false
    },
    {
      "severity": "critical",
      "tone": "danger",
      "isLossy": true,
      "why": "Five severities into four tones. Critical shares Danger with Error and the tone cannot say so, which is why the Rust toast prefixes its title."
    }
  ],
