      "isLossy": false
    },
    {
      "severity": "error",
      "tone": "danger",
      "isLossy": false
    },
    {
      "severity": "critical",
      "tone": "danger",
      "isLossy": true,
      "why": "Five severities into four tones. Critical shares Danger with Error and the tone cannot say so, which is why the Rust toast prefixes its title."
    }
  ],
